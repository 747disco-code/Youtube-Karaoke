{
  "manifest_version":  3,
  "name":  "YouTube Karaoke Helper",
  "version": "3.0.0",
  "description": "Scarica video YouTube e apri player dual-monitor per karaoke",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Karaoke Helper"
  },
  "web_accessible_resources": [{
    "resources": ["player.html", "control.html", "player.js", "control.js"],
    "matches": ["<all_urls>"]
  }]
}